NODE_ENV=production
PORT=5000
# PostgreSQL connection. Use `sslmode=verify-full` for strict verification.
# Replace host/user/password/dbname as needed for your environment.
DATABASE_URL=postgres://postgres:RowdyCloudy123@rowdy-db-restored.c9s0yccko10l.eu-central-1.rds.amazonaws.com:5432/aws?sslmode=verify-full

# Handy for running psql non-interactively (optional). If you enable, keep secure.
# PGPASSWORD=RowdyCloudy123

# Frontend origin allowed for CORS (CloudFront distribution hostname)
ALLOWED_ORIGINS=https://d1to0licb5spp5.cloudfront.net

# AWS settings
AWS_REGION=eu-central-1

# Path to the downloaded Amazon RDS trust bundle (global-bundle.pem).
# Download on the EC2 host: https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
GLOBAL_BUNDLE_PATH=./global-bundle.pem

# Make Node pick up the CA (optional alternative to installing system CA).
# Uncomment and/or set this in PM2 environment if you prefer not to install system CA.
# NODE_EXTRA_CA_CERTS=/home/ubuntu/hotel-crm/Backend/global-bundle.pem

# Security: secret value that CloudFront will send as header (x-origin-secret)
# Keep this value secret and match it in CloudFront origin configuration.
ORIGIN_SECRET=7e3b9f1a2c4d6f8e9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2

# App logging and DB pool defaults
LOG_LEVEL=info
DB_POOL_MAX=10

# Optional flags
DISABLE_ROOM_SYNC=false
