PORT=5000
# Example production DATABASE_URL (replace with your RDS or remote Postgres)
DATABASE_URL=postgres://postgres:YourStrongPassword@your-rds-endpoint.region.rds.amazonaws.com:5432/aws

# Allowed frontend origins (comma separated)
ALLOWED_ORIGINS=https://your-frontend-domain.cloudfront.net

# AWS region
AWS_REGION=us-east-1

# DynamoDB audit table (optional)
#AUDIT_DYNAMODB_TABLE=rowdy-cloud-audit-logs

# Host to bind the server (0.0.0.0 binds all interfaces)
#HOST=0.0.0.0
