PORT=5000
# Example production DATABASE_URL (use RDS or a remote Postgres)
# DATABASE_URL=postgres://postgres:StrongPassword@my-rds-endpoint.region.rds.amazonaws.com:5432/aws
# Allowed frontend origins (comma separated)
# ALLOWED_ORIGINS=https://d123example.cloudfront.net
# AWS region
# AWS_REGION=us-east-1
# DynamoDB audit table (optional)
# AUDIT_DYNAMODB_TABLE=rowdy-cloud-audit-logs
